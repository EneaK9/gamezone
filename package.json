{
  "name": "kazemura",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kazemura — a samurai village game. Walk, talk, trade, and fight in a riverside village. NPC conversations are understood by TypeSafe's Jev.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/fetch-assets.mjs",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
